_APP_ENV=development
_APP_EDITION=self-hosted
_APP_LOCALE=en
_APP_OPENSSL_KEY_V1=__RANDOM_OPENSSL_KEY__
_APP_JOBS_SECRET=__RANDOM_JOBS_SECRET__
_APP_EXECUTOR_SECRET=__RANDOM_EXECUTOR_SECRET__
_APP_GEO_SECRET=__RANDOM_GEO_SECRET__
_APP_GEO_ENDPOINT=http://geo/v1
_APP_DOMAIN=localhost
_APP_CONSOLE_DOMAIN=localhost
_APP_CONSOLE_HOSTNAMES=localhost,127.0.0.1
_APP_OPTIONS_FORCE_HTTPS=disabled
_APP_OPTIONS_ROUTER_FORCE_HTTPS=disabled
_APP_OPTIONS_ROUTER_PROTECTION=disabled
_APP_OPTIONS_ABUSE=disabled
_APP_DB_ADAPTER=postgresql
_APP_DB_HOST=postgresql
_APP_DB_PORT=5432
_APP_DB_SCHEMA=appwrite
_APP_DB_USER=appwrite
_APP_DB_PASS=__RANDOM_DB_PASSWORD__
_APP_REDIS_HOST=redis
_APP_REDIS_PORT=6379
_APP_STORAGE_DEVICE=Local
_APP_STORAGE_ANTIVIRUS=disabled
_APP_USAGE_STATS=disabled
_APP_WORKER_PER_CORE=1
_APP_WORKERS_NUM=1
_APP_WORKER_MAX_COROUTINES=4
_APP_EMBEDDING=disabled
_APP_DOCUMENTSDB=disabled
_APP_VECTORSDB=disabled
_APP_LOGGING_FORMAT=pretty
