# Copy to .env and fill in. Never commit .env. All values are server-only.

# memory (dev/tests, data lost on restart) | appwrite
DATA_BACKEND=memory

# Appwrite (required when DATA_BACKEND=appwrite)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Server API key with scopes: users.read/write, sessions.write, databases.*, tables.*, rows.*
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=ai_tutor

# Optional AI tutor (Mastra). Off by default; the lesson works without it.
AI_ENABLED=false
AI_MODEL=anthropic/claude-sonnet-5-5
AI_API_KEY=
AI_DAILY_CALLS_PER_FAMILY=50
# Worksheet photo checks (Sprint 3, untested on real handwriting). Photos are not stored, only a sha256 hash.
VISION_ENABLED=false
VISION_MODEL=openrouter/deepseek/deepseek-v4.1-flash
VISION_DAILY_CHECKS_PER_FAMILY=20

# Override cookie Secure flag (defaults to true in production)
# SESSION_COOKIE_SECURE=true

# Knowledge retrieval (Sprint 2). memory = in-process index, rebuilt on approval only.
KNOWLEDGE_INDEX=memory
# Required when KNOWLEDGE_INDEX=qdrant. Local: pnpm qdrant:up
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=ai_tutor_knowledge
# Comma-separated emails allowed to run checks and approve knowledge versions
KNOWLEDGE_ADMIN_EMAILS=
# Daily scheduled check (03:17) stages new versions; approval stays manual
KNOWLEDGE_AUTO_CHECK=false

# Optional natural voice for reading lessons aloud (ElevenLabs). Empty = the browser's own voice.
# Only lesson text is sent, never the learner's voice. Clips are cached (Appwrite bucket "speech").
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
SPEECH_HOURLY_CLIPS_PER_FAMILY=200

# Rate limit counters: memory (one instance) | appwrite (shared table "rate_limits").
# Defaults to DATA_BACKEND; appwrite needs DATA_BACKEND=appwrite.
# RATE_LIMIT_BACKEND=appwrite

# Data retention (Nitro task retention:purge, daily at 03:41). Dry run (logs counts only) unless enabled.
RETENTION_PURGE_ENABLED=false
# Unfinished lessons older than this are deleted
RETENTION_OPEN_SESSION_DAYS=30
# Worksheet photo check results (transcription, flags); the derived answers stay as evidence
RETENTION_WORKSHEET_CHECK_DAYS=90
# Audit log entries (minimum 30)
RETENTION_AUDIT_LOG_DAYS=400
# Mastery evidence (completed lessons, answers, status history). 0 = keep forever; otherwise at least 365
RETENTION_EVIDENCE_DAYS=0
