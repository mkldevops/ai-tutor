{
  "name": "ai-tutor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:appwrite": "E2E_DATA_BACKEND=appwrite playwright test",
    "appwrite:up": "infra/appwrite/up.sh",
    "appwrite:down": "infra/appwrite/down.sh",
    "appwrite:bootstrap": "infra/appwrite/bootstrap.sh",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "appwrite:setup": "node --env-file-if-exists=.env scripts/appwrite-setup.ts",
    "qdrant:up": "docker compose --env-file .env -f infra/qdrant/compose.yaml up -d",
    "qdrant:down": "docker compose --env-file .env -f infra/qdrant/compose.yaml down"
  },
  "dependencies": {
    "@mastra/core": "^1.83.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "ai": "^7.0.173",
    "nitro": "3.0.260610-beta",
    "node-appwrite": "^31.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
